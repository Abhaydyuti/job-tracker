<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">

    <div class="d-flex align-items-center mb-4">
      <a href="/jobs" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i> Back
      </a>
      <h2 class="fw-bold mb-0">Add New Application</h2>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-4">

        <!-- Errors -->
        <% if (errors.length > 0) { %>
          <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
              <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/jobs" method="POST" novalidate>

          <div class="row g-3">

            <!-- Company Name -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">Company Name <span class="text-danger">*</span></label>
              <input type="text" name="company_name" class="form-control"
                placeholder="e.g. Google"
                value="<%= old.company_name || '' %>" required />
            </div>

            <!-- Role -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">Role / Job Title <span class="text-danger">*</span></label>
              <input type="text" name="role" class="form-control"
                placeholder="e.g. Backend Developer"
                value="<%= old.role || '' %>" required />
            </div>

            <!-- Status -->
            <div class="col-md-4">
              <label class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
              <select name="status" class="form-select" required>
                <% statusOptions.forEach(s => { %>
                  <option value="<%= s %>" <%= old.status === s ? 'selected' : '' %>>
                    <%= s %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Applied Date -->
            <div class="col-md-4">
              <label class="form-label fw-semibold">Applied Date</label>
              <input type="date" name="applied_date" class="form-control"
                value="<%= old.applied_date ? old.applied_date.toString().substring(0,10) : '' %>" />
            </div>

            <!-- Interview Date -->
            <div class="col-md-4">
              <label class="form-label fw-semibold">Interview Date</label>
              <input type="date" name="interview_date" class="form-control"
                value="<%= old.interview_date ? old.interview_date.toString().substring(0,10) : '' %>" />
            </div>

            <!-- Job Link -->
            <div class="col-12">
              <label class="form-label fw-semibold">Job Posting Link</label>
              <input type="url" name="link" class="form-control"
                placeholder="https://careers.google.com/..."
                value="<%= old.link || '' %>" />
            </div>

            <!-- Notes -->
            <div class="col-12">
              <label class="form-label fw-semibold">Notes</label>
              <textarea name="notes" class="form-control" rows="3"
                placeholder="Recruiter contact, interview tips, referral info..."><%= old.notes || '' %></textarea>
            </div>

          </div><!-- /row -->

          <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-plus-circle me-1"></i>Add Application
            </button>
            <a href="/jobs" class="btn btn-outline-secondary">Cancel</a>
          </div>

        </form>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>