<%- include('../partials/header') %>

<!-- Welcome Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold mb-1">Welcome back, <%= userName %> 👋</h1>
    <p class="text-muted mb-0">Here's your job hunt at a glance.</p>
  </div>
  <a href="/jobs/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>Add Job
  </a>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-5">

  <div class="col-6 col-md-3">
    <div class="card stat-card text-white text-center p-3" style="background:#0d6efd">
      <div class="display-6 fw-bold"><%= counts.total %></div>
      <div class="small mt-1">Total Applied</div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card stat-card text-white text-center p-3" style="background:#fd7e14">
      <div class="display-6 fw-bold"><%= counts.interviewing %></div>
      <div class="small mt-1">Interviewing</div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card stat-card text-white text-center p-3" style="background:#198754">
      <div class="display-6 fw-bold"><%= counts.offer %></div>
      <div class="small mt-1">Offers</div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card stat-card text-white text-center p-3" style="background:#dc3545">
      <div class="display-6 fw-bold"><%= counts.rejected %></div>
      <div class="small mt-1">Rejected</div>
    </div>
  </div>

</div>

<!-- Recent Applications -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0">Recent Applications</h4>
  <a href="/jobs" class="btn btn-outline-primary btn-sm">View All</a>
</div>

<% if (recentJobs.length === 0) { %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-briefcase display-4 d-block mb-3"></i>
    <p>No applications yet.</p>
    <a href="/jobs/new" class="btn btn-primary">Add Your First Application</a>
  </div>
<% } else { %>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Company</th>
            <th>Role</th>
            <th>Status</th>
            <th>Applied</th>
          </tr>
        </thead>
        <tbody>
          <% recentJobs.forEach(job => { %>
            <tr>
              <td class="fw-semibold"><%= job.company_name %></td>
              <td><%= job.role %></td>
              <td>
                <%
                  const badgeMap = {
                    'Applied':      'primary',
                    'Interviewing': 'warning text-dark',
                    'Offer':        'success',
                    'Rejected':     'danger'
                  };
                %>
                <span class="badge bg-<%= badgeMap[job.status] || 'secondary' %>">
                  <%= job.status %>
                </span>
              </td>
              <td class="text-muted small">
                <%= job.applied_date
                    ? new Date(job.applied_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})
                    : '—' %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>